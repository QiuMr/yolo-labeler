# ── 依赖 ──────────────────────────────────────────────
# 体积大且可随时用 npm ci 重装
node_modules

# ── 构建产物 ──────────────────────────────────────────
# 由 npm run build 生成；部署走 GitHub Actions，产物不进仓库
dist
# npm run share 生成的发布包（同上，产物不进仓库）
yolo-labeler-pages

# ── 测试中间产物 ──────────────────────────────────────
# test:parse / test:detector 用 esbuild 把 TS 转译到这里再跑断言，每次自动重建
.tmp

# ── 无头浏览器测试 ────────────────────────────────────
# npm run smoke 会自己重建这两份 Edge 用户目录（各有 50+ MB）
smoke/.edge-profile/
smoke/.repro-profile/
smoke/*.log
!smoke/.gitkeep

# ── 日志与打包残留 ────────────────────────────────────
*.log
*.rar

# ── 训练/导出权重 ─────────────────────────────────────
# ultralytics 的 .pt 只在「导出 onnx」时用得到，属于本机实验产物：
# 体积大、可从官方随时重新下载，不该进仓库。导出后的 onnx 才进 public/models/。
*.pt

# ── 智能体工作目录 ────────────────────────────────────
# .workbuddy/ 存的是「与本次工作相关的过程记录」（每日工作日志、长期备忘），
# 面向的是本机上的协作者，不是这个仓库的读者。
# 里面会包含本机绝对路径与内部判断过程，而本仓库是**公开**的，所以不进版本控制。
# 注意：目录本身要保留在磁盘上（它是工作数据，不是临时缓存），只是不让 git 跟踪。
.workbuddy/

# ── 编辑器 / 系统 ─────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.local
